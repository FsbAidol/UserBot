# Пример переменных окружения для UserBot.
# Скопируйте этот файл в .env и заполните своими значениями.
# На Heroku переменные задаются через: heroku config:set API_ID=... API_HASH=... BOT_TOKEN=...

API_ID=123456
API_HASH=your_api_hash_here
SESSION_STRING=your_telethon_session_string_here
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Настройки бота (опционально)
ADMIN_ID=123456789
LANG=ru
WORKERS=4
